# Uygulama ortamı
NODE_ENV=development

# Yerel PostgreSQL veritabanı
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/Deneme

# Yönetici erişim anahtarı
ADMIN_KEY=CHANGE_THIS_LOCAL_ADMIN_KEY

# E-posta bildirimleri
EMAIL_PASS=YOUR_EMAIL_APP_PASSWORD

# Telegram bildirimleri
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Yerel ortam güvenlik ayarları
ENABLE_SCRAPER=false
DISABLE_EXTERNAL_NOTIFICATIONS=true